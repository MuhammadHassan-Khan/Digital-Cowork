# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit
# `.env.local` or paste real keys into docs/code examples.
#
# Where each value comes from:
#   Supabase  -> https://supabase.com/dashboard -> select your project
#                -> Project Settings -> API
#   LiveKit   -> https://cloud.livekit.io -> your project -> Settings/Keys
#                (required from Stage 3: voice/video/chat)
# ---------------------------------------------------------------------------

# --- Supabase (required from Stage 1: auth + database) ---
# Project URL (public; safe for browser code)
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public API key (public; safe for browser code - RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Never prefix with NEXT_PUBLIC, never expose
# in client code. Only used by server-side code that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit (required from Stage 3: voice/video/chat) ---
# WebSocket URL of your LiveKit deployment, e.g. wss://example.livekit.cloud
# Public by design (the browser connects here directly). This app uses this
# single URL for both browser and server (server derives the REST host from it).
NEXT_PUBLIC_LIVEKIT_URL=
# API key / secret - SERVER ONLY. Used to sign short-lived room access tokens.
# Never prefix with NEXT_PUBLIC, never ship to the browser (PRD section 7).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Experimental multi-share gate (Stage 4). Leave blank for the reliable
# single-share baseline (one screen share rendered; viewers pick which one).
# Set to "true" to allow up to 5 simultaneous screen shares - experimental
# and NOT validated on real devices until the README documents test results.
NEXT_PUBLIC_ENABLE_MULTI_SHARE=

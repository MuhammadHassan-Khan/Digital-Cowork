# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit
# `.env.local` or paste real keys into docs/code examples.
#
# Where each value comes from:
#   Supabase  -> https://supabase.com/dashboard -> select your project
#                -> Project Settings -> API
#   LiveKit   -> https://cloud.livekit.io -> your project -> Settings/Keys
#                (used from Stage 4 onwards; blanks are OK until then)
# ---------------------------------------------------------------------------

# --- Supabase (required from Stage 1: auth + database) ---
# Project URL (public; safe for browser code)
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public API key (public; safe for browser code — RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC, never expose
# in client code. Only used by server-side code that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit (required from Stage 4: voice/video/screen share) ---
# WebSocket URL of your LiveKit deployment, e.g. wss://example.livekit.cloud
LIVEKIT_URL=
# Public URL only if your SDK setup needs it in the browser (usually the same
# ws URL above; leave blank unless you know you need a separate value)
NEXT_PUBLIC_LIVEKIT_URL=
# API key / secret — SERVER ONLY. Used to sign short-lived access tokens.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
